<%- include('../partials/header') %>

<div class="page-header">
    <h1><%= title %></h1>
    <p>Daftar semua cicilan Anda</p>
</div>

<div class="card">
    <div class="card-header flex-between">
        <span>Filter Status</span>
        <div class="flex gap-1">
            <a href="/user/installments" class="btn btn-sm <%= currentStatus === 'all' ? 'btn-primary' : 'btn-secondary' %>">Semua</a>
            <a href="/user/installments?status=pending" class="btn btn-sm <%= currentStatus === 'pending' ? 'btn-warning' : 'btn-secondary' %>">Pending</a>
            <a href="/user/installments?status=active" class="btn btn-sm <%= currentStatus === 'active' ? 'btn-success' : 'btn-secondary' %>">Active</a>
            <a href="/user/installments?status=completed" class="btn btn-sm <%= currentStatus === 'completed' ? 'btn-secondary' : 'btn-secondary' %>">Completed</a>
        </div>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>No. Cicilan</th>
                    <th>Produk</th>
                    <th>DP</th>
                    <th>Tenor</th>
                    <th>Cicilan/Bulan</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (installments.length === 0) { %>
                    <tr>
                        <td colspan="8" class="text-center">Tidak ada data</td>
                    </tr>
                <% } else { %>
                    <% installments.forEach(inst => { %>
                        <tr>
                            <td><%= inst.installment_number %></td>
                            <td><%= inst.product_name %> (<%= inst.product_weight %>g)</td>
                            <td><%= formatCurrency(inst.dp_amount) %></td>
                            <td><%= inst.tenor_months %> bulan</td>
                            <td><%= formatCurrency(inst.monthly_payment) %></td>
                            <td><%= formatCurrency(inst.total_payment) %></td>
                            <td>
                                <span class="badge badge-<%= inst.status %>">
                                    <%= inst.status %>
                                </span>
                            </td>
                            <td>
                                <a href="/user/installments/<%= inst.id %>" class="btn btn-sm btn-info">Detail</a>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
