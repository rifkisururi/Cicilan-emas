<%- include('../partials/header') %>

<div class="page-header">
    <h1><%= title %></h1>
    <p>Atur konfigurasi sistem cicilan emas</p>
</div>

<div class="card">
    <div class="card-header">Konfigurasi Margin & Biaya</div>
    <form id="configForm" onsubmit="handleSaveConfig(event)">
        <div class="form-group">
            <label>Margin (%) per Tahun</label>
            <input
                type="number"
                step="0.01"
                name="margin_percent"
                class="form-control"
                value="<%= config.margin_percent.value %>"
                required
            >
            <small style="color: var(--gray-text);"><%= config.margin_percent.description %></small>
        </div>

        <div class="form-group">
            <label>Minimum DP (%)</label>
            <input
                type="number"
                step="0.01"
                name="min_dp_percent"
                class="form-control"
                value="<%= config.min_dp_percent.value %>"
                required
            >
            <small style="color: var(--gray-text);"><%= config.min_dp_percent.description %></small>
        </div>

        <div class="form-group">
            <label>Maksimum DP (%)</label>
            <input
                type="number"
                step="0.01"
                name="max_dp_percent"
                class="form-control"
                value="<%= config.max_dp_percent.value %>"
                required
            >
            <small style="color: var(--gray-text);"><%= config.max_dp_percent.description %></small>
        </div>

        <div class="form-group">
            <label>Biaya Admin (%)</label>
            <input
                type="number"
                step="0.01"
                name="admin_fee_percent"
                class="form-control"
                value="<%= config.admin_fee_percent.value %>"
                required
            >
            <small style="color: var(--gray-text);"><%= config.admin_fee_percent.description %></small>
        </div>

        <div class="form-group">
            <label>Denda per Hari (%)</label>
            <input
                type="number"
                step="0.01"
                name="penalty_per_day"
                class="form-control"
                value="<%= config.penalty_per_day.value %>"
                required
            >
            <small style="color: var(--gray-text);"><%= config.penalty_per_day.description %></small>
        </div>

        <button type="submit" class="btn btn-primary" id="saveBtn">
            Simpan Konfigurasi
        </button>
    </form>
</div>

<script>
async function handleSaveConfig(event) {
    event.preventDefault();

    const formData = new FormData(event.target);
    const configs = Object.fromEntries(formData.entries());

    const btn = document.getElementById('saveBtn');
    setButtonLoading(btn, true);

    try {
        const response = await API.post('/api/system-config/batch', { configs });

        if (response.success) {
            showAlert('Konfigurasi berhasil disimpan', 'success');
        }
    } catch (error) {
        showAlert(error.message || 'Gagal menyimpan konfigurasi', 'danger');
    } finally {
        setButtonLoading(btn, false);
    }
}
</script>

<%- include('../partials/footer') %>
