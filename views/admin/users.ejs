<%- include('../partials/header') %>

<div class="page-header">
    <h1><%= title %></h1>
    <p>Daftar semua user yang terdaftar</p>
</div>

<div class="card">
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Nama Lengkap</th>
                    <th>Email</th>
                    <th>Telepon</th>
                    <th>Total Cicilan</th>
                    <th>Cicilan Aktif</th>
                    <th>Terdaftar</th>
                </tr>
            </thead>
            <tbody>
                <% if (users.length === 0) { %>
                    <tr>
                        <td colspan="7" class="text-center">Tidak ada data</td>
                    </tr>
                <% } else { %>
                    <% users.forEach(user => { %>
                        <tr>
                            <td><%= user.username %></td>
                            <td><%= user.full_name %></td>
                            <td><%= user.email %></td>
                            <td><%= user.phone || '-' %></td>
                            <td><%= user.total_installments %></td>
                            <td><%= user.active_installments %></td>
                            <td><%= formatDate(user.created_at) %></td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
